{
    "name": "mosesolayemi/laravel-cms",
    "description": "A self-contained CMS for Laravel: content models, a page builder, its own admin guard and a Filament back office.",
    "type": "library",
    "keywords": [
        "laravel",
        "cms",
        "filament",
        "page-builder",
        "content-management"
    ],
    "homepage": "https://github.com/mosesolayemi/laravel-cms",
    "license": "proprietary",
    "authors": [
        {
            "name": "Phynix Media",
            "homepage": "https://phynixmedia.co.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/mosesolayemi/laravel-cms/issues",
        "source": "https://github.com/mosesolayemi/laravel-cms"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "PhynixMedia\\Cms\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhynixMedia\\Cms\\CmsServiceProvider"
            ],
            "aliases": {
                "Cms": "PhynixMedia\\Cms\\Facades\\Cms"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
