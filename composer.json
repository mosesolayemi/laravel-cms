{
    "name": "ambulance/cms",
    "description": "Self-contained CMS: content models, admin guard and Filament back office.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cms\\CmsServiceProvider"
            ],
            "aliases": {
                "Cms": "Cms\\Facades\\Cms"
            }
        }
    },
    "minimum-stability": "stable"
}
