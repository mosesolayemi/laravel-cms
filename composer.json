{
    "name": "ambulance/cms",
    "description": "Self-contained CMS: content models, admin guard and Filament back office.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "PhynixMedia\\Cms\\": "src/"
        },
        "classmap": [
            "src/database/seeds"
        ],
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhynixMedia\\Cms\\CmsServiceProvider"
            ],
            "aliases": {
                "Cms": "PhynixMedia\\Cms\\Facades\\Cms"
            }
        }
    },
    "minimum-stability": "stable"
}
